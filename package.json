{
  "name": "notlocalhost",
  "version": "0.1.1",
  "description": "Your localhost is lying to you. This tells you exactly how. Predicts what breaks when your dev server moves to a real HTTPS origin.",
  "keywords": [
    "localhost",
    "cookies",
    "samesite",
    "secure-context",
    "mixed-content",
    "cors",
    "https",
    "devtools",
    "ci",
    "static-analysis"
  ],
  "homepage": "https://github.com/jay123anta/notlocalhost#readme",
  "bugs": "https://github.com/jay123anta/notlocalhost/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jay123anta/notlocalhost.git"
  },
  "license": "MIT",
  "author": "Jayanta Kr. Nath",
  "type": "module",
  "bin": {
    "notlocalhost": "bin/notlocalhost.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node scripts/check-test-output.mjs",
    "lint": "node scripts/syntax-check.mjs",
    "evidence": "node evidence/repro-port-sharing.mjs",
    "test:unit": "node --test test/unit.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "fixture": "node test/fixtures/lying-app.mjs",
    "test:report": "node --test test/report.test.js",
    "test:compat": "node --test test/compat.test.js",
    "test:harness": "node --test test/harness.test.js",
    "test:lifecycle": "node --test test/lifecycle.test.js",
    "test:raw": "node --test test/compat.test.js test/unit.test.js test/e2e.test.js test/report.test.js test/harness.test.js test/lifecycle.test.js",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run lint && node scripts/prepublish-check.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.56.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}
